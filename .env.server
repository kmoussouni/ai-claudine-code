# Configuration Serveur Claudine - Pour PC Puissant
# Copiez ce fichier vers .env sur votre serveur

# Modèle par défaut (utilisez les gros modèles ici)
DEFAULT_MODEL=qwen2.5-coder:32b

# URL Ollama (interne Docker)
OLLAMA_BASE_URL=http://ollama:11434

# Ports exposés
OLLAMA_PORT=11434
AGENT_PORT=3000
WEBUI_PORT=8080

# Sécurité - Token d'authentification pour l'API
# Générez un token sécurisé avec: openssl rand -hex 32
CLAUDINE_API_TOKEN=changeme_generate_a_secure_token_here

# Interface réseau (0.0.0.0 pour accepter connexions externes)
API_HOST=0.0.0.0

# Clé secrète WebUI
WEBUI_SECRET_KEY=changeme_webui_secret_key_here

# Logs
LOG_LEVEL=INFO

# GPU (décommentez si GPU NVIDIA disponible)
# NVIDIA_VISIBLE_DEVICES=all

# Stable Diffusion Configuration (Agent Multimodal)
SD_ENABLED=true
SD_API_URL=http://stable-diffusion:7860
SD_PORT=7860
SD_DEFAULT_MODEL=v1-5-pruned-emaonly.safetensors
SD_DEFAULT_STEPS=30
SD_DEFAULT_CFG_SCALE=7.5

# Génération d'images
IMAGE_OUTPUT_DIR=/workspace/generated-images
IMAGE_MAX_WIDTH=1024
IMAGE_MAX_HEIGHT=1024
