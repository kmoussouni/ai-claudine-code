# Configuration Claudine - Agent de Code Local

# Modèle par défaut à utiliser
# Options recommandées :
#   - qwen2.5-coder:7b (optimal, 4.7GB)
#   - qwen2.5-coder:32b (plus puissant, 19GB)
#   - deepseek-coder-v2:16b (excellent, 9GB)
#   - codellama:7b (spécialisé code, 3.8GB)
DEFAULT_MODEL=qwen2.5-coder:7b

# URL du serveur Ollama (laisser par défaut pour Docker)
OLLAMA_BASE_URL=http://ollama:11434

# Clé secrète pour WebUI (changez-la en production)
WEBUI_SECRET_KEY=changeme_secret_key_here

# Ports des services
OLLAMA_PORT=11434
AGENT_PORT=3000
WEBUI_PORT=8080

# Configuration GPU (décommenter si vous avez une GPU NVIDIA)
# NVIDIA_VISIBLE_DEVICES=all

# Token HuggingFace — requis pour télécharger FLUX.1-schnell
# 1. Créez un compte sur https://huggingface.co
# 2. Acceptez la licence FLUX : https://huggingface.co/black-forest-labs/FLUX.1-schnell
# 3. Générez un token (read) : https://huggingface.co/settings/tokens
HF_TOKEN=

# FLUX / ComfyUI
FLUX_ENABLED=true
FLUX_API_URL=http://flux-comfyui:8188
FLUX_PORT=8188

# Génération d'images
IMAGE_OUTPUT_DIR=/workspace/generated-images
IMAGE_MAX_WIDTH=1024
IMAGE_MAX_HEIGHT=1024
