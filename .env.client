# Configuration Client Claudine - Pour utilisation distante
# Copiez ce fichier vers .env sur votre client

# URL du serveur Claudine distant
# Option 1 : Via tunnel SSH (recommandé)
CLAUDINE_API_URL=http://localhost:3000

# Option 2 : Connexion directe (nécessite VPN ou IP publique)
# CLAUDINE_API_URL=https://votre-serveur.com:3000

# Option 3 : IP locale (même réseau)
# CLAUDINE_API_URL=http://192.168.1.100:3000

# URL Ollama (via tunnel ou direct)
OLLAMA_API_BASE=http://localhost:11434

# Token d'authentification (même que sur le serveur)
CLAUDINE_API_TOKEN=your_token_here

# Modèle par défaut (doit être installé sur le serveur)
DEFAULT_MODEL=qwen2.5-coder:32b

# Mode client (pas de services Docker locaux)
CLIENT_MODE=true

# Timeout pour requêtes longues (en secondes)
REQUEST_TIMEOUT=300
