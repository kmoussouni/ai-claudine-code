#!/bin/bash
# Launcher pour les agents CLI Claudine

set -e

# Couleurs
BLUE='\033[0;34m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Banner
echo -e "${BLUE}"
cat << "EOF"
╔══════════════════════════════════════════════════════════╗
║              Claudine - Launcher d'Agents                ║
╚══════════════════════════════════════════════════════════╝
EOF
echo -e "${NC}"

# Vérifier que les services tournent
if ! docker-compose ps | grep -q "claudine-ollama.*Up"; then
    echo -e "${YELLOW}⚠️  Les services ne sont pas démarrés${NC}"
    echo -e "${CYAN}   Démarrage automatique...${NC}"
    make start
    echo ""
fi

# Menu de sélection
echo -e "${CYAN}Choisissez votre agent CLI :${NC}"
echo ""
echo "  1) Agent Smart (⭐ RECOMMANDÉ)"
echo "     → Conversation + Modification de code avec permissions"
echo "     → Comprend votre projet et demande avant de modifier"
echo ""
echo "  2) Agent Interactif (Simple)"
echo "     → Session conversationnelle via API"
echo ""
echo "  3) Agent Aider (Power users)"
echo "     → Modifications de code puissantes avec Git"
echo ""
echo "  4) Agent TUI (Interface moderne)"
echo "     → Interface terminal avec vue splitée"
echo ""
echo "  5) Quitter"
echo ""

read -p "Votre choix [1-5]: " choice

case $choice in
    1)
        echo ""
        echo -e "${GREEN}🚀 Lancement de l'Agent Smart...${NC}"
        echo ""
        python3 scripts/claudine-smart.py
        ;;
    2)
        echo ""
        echo -e "${GREEN}🚀 Lancement de l'Agent Interactif...${NC}"
        echo ""
        python3 scripts/agent-interactive.py
        ;;
    3)
        echo ""
        echo -e "${GREEN}🚀 Lancement de l'Agent Aider...${NC}"
        echo ""
        ./scripts/agent-aider.sh
        ;;
    4)
        echo ""
        echo -e "${GREEN}🚀 Lancement de l'Agent TUI...${NC}"
        echo ""
        python3 scripts/agent-tui.py
        ;;
    5)
        echo ""
        echo -e "${GREEN}👋 Au revoir !${NC}"
        exit 0
        ;;
    *)
        echo ""
        echo -e "${YELLOW}❌ Choix invalide${NC}"
        exit 1
        ;;
esac
